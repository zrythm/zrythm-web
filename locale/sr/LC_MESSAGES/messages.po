#: template.py:399
msgid "Stereo dynamic range compressor"
msgstr "Стерео динамички опсег компресора"

#: template.py:402
msgid "Cubic nonlinearity distortion"
msgstr "Кубна нелинеарна дисторзија"

#: template.py:405
msgid "Stereo flanging effect"
msgstr "Стерео флангирајући ефекат"

#: template.py:408
msgid "Stereo signal gate"
msgstr "Стерео сигнална капија"

#: template.py:411
msgid "2nd-order Butterworth highpass filter"
msgstr "Butterworth високопропусни филтер 2. реда"

#: template.py:414
msgid "2nd-order Butterworth lowpass filter"
msgstr "Butterworth нископропусни филтер 2. реда"

#: template.py:417
msgid "Parametric equalizer"
msgstr "Параметарски еквализер"

#: template.py:420
msgid "Dynamic range compressor modelled after the 1176 peak limiter"
msgstr "Динамички опсег компресора моделован по 1176 лимитеру врха"

#: template.py:423
msgid "Phasing effect"
msgstr "Фазни ефекат"

#: template.py:426
msgid "Polyphonic synthesizer with 3 detuned oscillator voices"
msgstr "Полифонични синтезатор са 3 детунирана осцилатора"

#: template.py:429
msgid ""
"Delay that doesn't click and doesn't transpose when the delay time is "
"changed"
msgstr "Кашњење без кликова и транспозиције када се време кашњења промени"

#: template.py:432
msgid "Wah pedal effect to the 4th order"
msgstr "Ефекат Вах педале 4. реда"

#: template.py:435
msgid "White noise generator"
msgstr "Генератор белог шума"

#: template.py:438
msgid "8x8 late-reverberation FDN reverb"
msgstr "8x8 касна-рееверберација ФДН реверб"

#: template.py:443
msgid "ZChordz maps the chords of a minor or major scale to white keys"
msgstr "ZChordz мапира акорде мале или велике лествице на беле дирке"

#: template.py:444
msgid "Major or minor scale"
msgstr "Велика или мала лествица"

#: template.py:445
msgid "Velocity multiplier per note"
msgstr "Множитељ брзине по ноти"

#: template.py:448
msgid "ZLFO is a fully featured LFO for CV-based automation"
msgstr "ZLFO је потпуно опремљен LFO за аутоматизацију засновану на CV-у"

#: template.py:449
msgid "Multi-oscillator with custom wave"
msgstr "Мулти-осцилатор са прилагођеним таласом"

#: template.py:450
msgid "Phase shift"
msgstr "Фазни помак"

#: template.py:451
msgid "Vertical/horizontal inversion"
msgstr "Вертикална/хоризонтална инверзија"

#: template.py:452
msgid "Step mode"
msgstr "Корак режим"

#: template.py:453
msgid "Editable range"
msgstr "Опсег који се може уређивати"

#: template.py:454
msgid "Sync to host or free-form"
msgstr "Синхронизација са домаћином или слободни облик"

#: template.py:457
msgid "ZSaw is a supersaw synth with 1 parameter"
msgstr "ZSaw је supersaw синт са 1 параметром"

#: template.py:458
msgid "7 sawtooth oscillators"
msgstr "7 осцилатора са тестера таласом"

#: template.py:459
msgid "Single knob to control detune"
msgstr "Један дугме за контролу детуна"

#: template.py:470 template.py:712
msgid "Intuitive Editing"
msgstr "Интуитивно уређивање"

#: template.py:473
msgid "Flexible Select Tool"
msgstr "Флексибилан алат за избор"

#: template.py:474
msgid ""
"Select, move, resize, clone, link, loop, delete and cut objects with a "
"{ref}single tool{endref}."
msgstr ""
"Изаберите, померите, промените величину, клонирајте, повежите, петљајте, "
"избришите и исеците објекте са {ref}једним алатом{endref}."

#: template.py:476
msgid "Extensive Toolbox"
msgstr "Обиман алатник"

#: template.py:477
msgid ""
"Extend select tool functionality by switching to the {ref}Edit, Cut, Erase, "
"Ramp or Audition tools{endref}."
msgstr ""
"Проширите функционалност алата за избор преласком на {ref}алате за "
"уређивање, сечење, брисање, рампу или аудицију{endref}."

#: template.py:479
msgid "Adaptive Snapping"
msgstr "Адаптивно снаповање"

#: template.py:480
msgid "Snapping behavior adjusts to the current zoom level."
msgstr "Понашање снаповања се прилагођава тренутном нивоу зумирања."

#: template.py:482
msgid "Looping"
msgstr "Петљање"

#: template.py:483
msgid "Loop audio, MIDI, automation and chord clips."
msgstr "Петљајте аудио, MIDI, аутоматизацију и клипове акорда."

#: template.py:486 template.py:727
msgid "Featureful Timeline"
msgstr "Функционална временска линија"

#: template.py:489
msgid "Track Lanes"
msgstr "Страна трака"

#: template.py:490
msgid ""
"Add multiple layers of audio/MIDI to the same track using {ref}track "
"lanes{endref}."
msgstr ""
"Додајте више слојева аудио/MIDI на исту траку користећи {ref}стране "
"трака{endref}."

#: template.py:492
msgid "Bounce in Place"
msgstr "Бунц у месту"

#: template.py:493
msgid "Quickly bounce selected material to audio."
msgstr "Брзо бунцујте одабрани материјал у аудио."

#: template.py:495
msgid "Stretching"
msgstr "Растезање"

#: template.py:496
msgid "Stretch any type of region"
msgstr "Растегните било коју врсту региона"

#: template.py:499
msgid "Powerful Editors"
msgstr "Моћни уређивачи"

#: template.py:502
msgid "Piano Roll"
msgstr "Пијано рол"

#: template.py:503
msgid ""
"Create, edit and arrange MIDI events in a dedicated piano roll with chord "
"integration."
msgstr ""
"Креирајте, уређујте и организујте MIDI догађаје у посвећеном пијано ролу са "
"интеграцијом акорда."

#: template.py:505
msgid "Drum View"
msgstr "Поглед на бубњеве"

#: template.py:506
msgid "One-click switch to drum view for editing single-hit instruments."
msgstr ""
"Пребаците се на поглед на бубњеве једним кликом за уређивање инструмената са "
"једним ударцем."

#: template.py:508
msgid "Velocity Editor"
msgstr "Уређивач брзине"

#: template.py:509
msgid ""
"Edit multiple velocities simultaneously with the select tool or draw with "
"the pencil or ramp tool."
msgstr ""
"Уређујте више брзина истовремено са алатом за избор или цртајте оловком или "
"алатом за рампу."

#: template.py:511
msgid "Audio Editor"
msgstr "Аудио уређивач"

#: template.py:512
msgid ""
"Adjust fades/gain and edit parts of audio clips using audio functions inside"
" the audio editor."
msgstr ""
"Подесите бледење/појачање и уређујте делове аудио клипова користећи аудио "
"функције унутар аудио уређивача."

#: template.py:514
msgid "List Editors"
msgstr "Уређивачи листе"

#: template.py:515
msgid "Edit object parameters manually in the event viewer."
msgstr "Ручно уређујте параметре објеката у прегледачу догађаја."

#: template.py:517
msgid "Editor Functions"
msgstr "Функције уређивача"

#: template.py:518
msgid ""
"Quickly apply functions like Legato, Invert and Fade Out to the selected "
"objects."
msgstr ""
"Брзо примените функције као што су Легато, Инверт и Фаде Оут на одабране "
"објекте."

#: template.py:520
msgid "External App Integration"
msgstr "Интеграција са спољним апликацијама"

#: template.py:521
msgid "Edit selected audio parts in any external app."
msgstr "Уређујте одабране делове аудио записа у било којој спољној апликацији."

#: template.py:524
msgid "Recording Capabilities"
msgstr "Снимање могућности"

#: template.py:527
msgid "Audio/MIDI Recording"
msgstr "Аудио/MIDI снимање"

#: template.py:528
msgid ""
"Record audio/MIDI from any of your devices, or even from other apps using "
"JACK."
msgstr ""
"Снимајте аудио/MIDI са било ког вашег уређаја, или чак из других апликација "
"користећи JACK."

#: template.py:530
msgid "Comprehensive Recording Settings"
msgstr "Свеобухватна подешавања снимања"

#: template.py:531
msgid ""
"Use punch in/punch out, record on MIDI input, and optionally create multiple"
" takes."
msgstr ""
"Користите punch in/punch out, снимајте на MIDI улазу и опционално креирајте "
"више покушаја."

#: template.py:533
msgid "Automation Recording"
msgstr "Снимање аутоматизације"

#: template.py:534
msgid "Record automation in latch/touch mode."
msgstr "Снимајте аутоматизацију у latch/touch режиму."

#: template.py:536
msgid "Device Controls"
msgstr "Контроле уређаја"

#: template.py:537
msgid ""
"Bind your device knobs to controls inside Zrythm and record your actions."
msgstr ""
"Вежите дугмад вашег уређаја за контроле унутар Zrythm-а и снимајте ваше "
"акције."

#: template.py:540 template.py:718
msgid "Mixing Capabilities"
msgstr "Могућности миксања"

#: template.py:543
msgid "Group Tracks"
msgstr "Групне траке"

#: template.py:544
msgid "Organize audio/MIDI signal groups with group tracks."
msgstr "Организујте групе аудио/MIDI сигнала са групним тракама."

#: template.py:546
msgid "Aux Sends"
msgstr "Аукс слања"

#: template.py:547
msgid "Easily route signals to FX tracks and plugin sidechain inputs."
msgstr "Лако усмеравајте сигнале на FX траке и улазе сајдчејн додатака."

#: template.py:549
msgid "In-Context Listening"
msgstr "Слушање у контексту"

#: template.py:550
msgid ""
"Listen to specified tracks in the context of the mix by dimming down every "
"other track."
msgstr ""
"Слушајте одређене траке у контексту микса тако што ћете пригушити све друге "
"траке."

#: template.py:552
msgid "Monitor Section"
msgstr "Секција за мониторинг"

#: template.py:553
msgid ""
"Change listen/mute/solo behavior and adjust what goes to your speakers."
msgstr ""
"Промените понашање слушања/мутирања/соло и подесите шта иде на ваше звучнике."

#: template.py:556
msgid "Unlimited Automation"
msgstr "Неограничена аутоматизација"

#: template.py:559
msgid "Anywhere-to-Anywhere Connections"
msgstr "Повезивања било где-било где"

#: template.py:560
msgid "Connect anything to anything."
msgstr "Повежите било шта са било чим."

#: template.py:562
msgid "Automation Curves"
msgstr "Криве аутоматизације"

#: template.py:563
msgid ""
"Automate parameters with straight lines or curves, choosing from multiple "
"curve algorithms, such as Exponential and Elliptic curves."
msgstr ""
"Аутоматизујте параметре са правим линијама или кривама, бирајући између више "
"алгоритама кривих, као што су експоненцијалне и елиптичне криве."

#: template.py:565
msgid "Envelopes"
msgstr "Омоти"

#: template.py:566
msgid ""
"Automate parameters with CV signals or envelopes, including macro knobs and "
"LFO plugins such as ZLFO."
msgstr ""
"Аутоматизујте параметре са CV сигналима или омотима, укључујући макро дугмад "
"и LFO додатке као што је ZLFO."

#: template.py:568
msgid "Automate Anything"
msgstr "Аутоматизујте било шта"

#: template.py:569
msgid ""
"Automate any possible parameter, including the project's BPM and time "
"signature."
msgstr ""
"Аутоматизујте било који могући параметар, укључујући BPM и временски потпис "
"пројекта."

#: template.py:572
msgid "Intuitive User Interface"
msgstr "Интуитивни кориснички интерфејс"

#: template.py:575
msgid "Detachable Views"
msgstr "Одвојиви прикази"

#: template.py:576
msgid ""
"Detach views from any panel and work efficiently with multi-monitor setups."
msgstr ""
"Одвојите приказе са било ког панела и радите ефикасно са подешавањима са "
"више монитора."

#: template.py:578
msgid "Searchable Preferences"
msgstr "Претраживе преференције"

#: template.py:579
msgid "Start typing to locate the preference you're looking for."
msgstr "Почните да куцате да бисте пронашли преференцију коју тражите."

#: template.py:581
msgid "Inspector Pages"
msgstr "Странице инспектора"

#: template.py:582
msgid "Edit all track and plugin parameters in the inspector."
msgstr "Уређујте све параметре трака и додатака у инспектору."

#: template.py:585
msgid "Plugin Capabilities"
msgstr "Могућности додатака"

#: template.py:588
msgid "Plugin Support"
msgstr "Подршка за додатке"

#: template.py:589
msgid ""
"Thanks to {ref}Carla{endref}, Zrythm supports a variety of plugin formats "
"including LV2, VST2, VST3 and AU."
msgstr ""

#: template.py:591
msgid "SoundFonts as Plugins"
msgstr "SoundFonts као додаци"

#: template.py:592
msgid "Use SFZ and SF2 soundfonts as instrument plugins."
msgstr "Користите SFZ и SF2 soundfont-ове као инструмент додатке."

#: template.py:594
msgid "Flexible Plugin Browser"
msgstr "Флексибилан прегледач додатака"

#: template.py:595
msgid ""
"Easily filter plugins by author, format or category, and organize your "
"favorite plugins with plugin collections."
msgstr ""
"Лако филтрирајте додатке по аутору, формату или категорији, и организујте "
"ваше омиљене додатке са колекцијама додатака."

#: template.py:597
msgid "Plugin Bridging"
msgstr "Мостирање додатака"

#: template.py:598
msgid "Sandbox plugins by opening them in bridge mode."
msgstr "Сандбоксујте додатке тако што ћете их отворити у мост режиму."

#: template.py:600
msgid "Automatable Bypass Mode"
msgstr "Аутоматизовани режим заобилажења"

#: template.py:601
msgid "Easily bypass plugins in the signal chain with an automatable control."
msgstr "Лако заобиђите додатке у ланцу сигнала са аутоматизованом контролом."

#: template.py:604
msgid "Comprehensive Import/Export"
msgstr "Свеобухватан увоз/извоз"

#: template.py:607
msgid "File Browser"
msgstr "Прегледач датотека"

#: template.py:608
msgid ""
"Browse and audition MIDI and audio files, and organize your favorite paths "
"with favorites."
msgstr ""
"Прегледајте и слушајте MIDI и аудио датотеке, и организујте ваше омиљене "
"путање са омиљеним."

#: template.py:610
msgid "Audio Files"
msgstr "Аудио датотеке"

#: template.py:611
msgid ""
"Import or export any format supported by {ref}libsndfile{endref}, with "
"additional MP3 import support."
msgstr ""
"Увезите или извозите било који формат подржан од {ref}libsndfile{endref}, са "
"додатном подршком за MP3 увоз."

#: template.py:613
msgid "MIDI"
msgstr "MIDI"

#: template.py:614
msgid ""
"Import or export any part of the project in MIDI Type 0 or Type 1 formats."
msgstr ""
"Увезите или извозите било који део пројекта у MIDI Type 0 или Type 1 "
"форматима."

#: template.py:616
msgid "Stem Export"
msgstr "Извоз стабала"

#: template.py:617
msgid "Export stems for specific tracks and share them with other producers."
msgstr "Извезите стабла за одређене траке и поделите их са другим продуцентима."

#: template.py:620 template.py:721
msgid "Chord Assistance"
msgstr "Помоћ за акорде"

#: template.py:623
msgid "Chord Audition"
msgstr "Аудиција акорда"

#: template.py:624
msgid ""
"Quickly listen to chords by clicking the pads or pressing notes on your MIDI"
" keyboard, and drag-and-drop chords to the timeline."
msgstr ""
"Брзо слушајте акорде кликом на падове или притиском на ноте на вашем MIDI "
"клавијатури, и превуците и испустите акорде на временску линију."

#: template.py:626
msgid "Chord Editing"
msgstr "Уређивање акорда"

#: template.py:627
msgid ""
"Invert chords with a single click or use the chord selector to choose any "
"chord, with an option to filter chords in the current scale."
msgstr ""
"Инвертујте акорде једним кликом или користите селектор акорда да изаберете "
"било који акорд, са опцијом да филтрирате акорде у тренутној скали."

#: template.py:629
msgid "Recordable Chord Track"
msgstr "Снимајућа трака акорда"

#: template.py:630
msgid ""
"Dictate or record the scale and chord progression of the project, and "
"optionally route the output to an instrument."
msgstr ""
"Диктирајте или снимите скалу и прогресију акорда пројекта, и опционално "
"усмерите излаз на инструмент."

#: template.py:632
msgid "Chord Presets"
msgstr "Пресети акорда"

#: template.py:633
msgid ""
"Generate chords from a wide range of scales, load included chord presets for"
" various genres, or save your own."
msgstr ""
"Генеришите акорде из широког спектра скала, учитајте укључене пресете акорда "
"за различите жанрове, или сачувајте своје."

#: template.py:636 template.py:730
msgid "Never Lose Work"
msgstr "Никада не изгубите рад"

#: template.py:639
msgid "Project Backups"
msgstr "Резервне копије пројекта"

#: template.py:640
msgid "Backups taken automatically at user-specified intervals."
msgstr "Резервне копије се праве аутоматски у интервалима које корисник одреди."

#: template.py:642
msgid "Undoable Actions"
msgstr "Поништиве акције"

#: template.py:643
msgid "Almost every user action is undoable."
msgstr "Скоро свака корисничка акција је поништива."

#: template.py:645
msgid "Serializable Undo History"
msgstr "Серијализована историја поништавања"

#: template.py:646
msgid "Keep your undo history when saving projects."
msgstr "Сачувајте историју поништавања када чувате пројекте."

#: template.py:649
msgid "Scripting"
msgstr "Скриптовање"

#: template.py:652
msgid "Extend Zrythm"
msgstr "Проширите Zrythm"

#: template.py:653
msgid ""
"Extend the capabilities of Zrythm by editing its state using {ref}GNU Guile "
"scripts{endref}."
msgstr ""
"Проширите могућности Zrythm-а уређивањем његовог стања користећи {ref}GNU "
"Guile скрипте{endref}."

#: template.py:655
msgid "Custom Editor Functions"
msgstr "Прилагођене функције уређивача"

#: template.py:656
msgid "Implement your own MIDI/audio/automation functions (coming soon)."
msgstr "Имплементирајте своје MIDI/аудио/аутоматизационе функције (ускоро)."

#: template.py:658
msgid "Project Generation"
msgstr "Генерација пројекта"

#: template.py:659
msgid "Generate projects with GNU Guile scripts."
msgstr "Генеришите пројекте са GNU Guile скриптама."

#: template.py:662
msgid "Optimized Performance"
msgstr "Оптимизоване перформансе"

#: template.py:665
msgid "Hardware accelerated UI"
msgstr "Хардверски убрзан кориснички интерфејс"

#: template.py:666
msgid ""
"Most of the user interface is drawn on the GPU thanks to {ref}GTK4{endref}."
msgstr ""
"Већина корисничког интерфејса је нацртана на GPU захваљујући "
"{ref}GTK4{endref}."

#: template.py:668
msgid "SIMD-optimized DSP"
msgstr "SIMD-оптимизован DSP"

#: template.py:669
msgid ""
"Zrythm uses {ref}lsp-dsp-lib{endref} which implements SIMD extensions such "
"as SSE, AVX and FMA when available to speed up audio processing and minimize"
" DSP usage."
msgstr ""
"Zrythm користи {ref}lsp-dsp-lib{endref} који имплементира SIMD екстензије "
"као што су SSE, AVX и FMA када су доступне, да убрза аудио обраду и "
"минимизира коришћење DSP-а."

#: template.py:671
msgid "Extensive Caching"
msgstr "Обимно кеширање"

#: template.py:672
msgid "Expensive computations are pre-calculated to save processing time."
msgstr "Скупи прорачуни се унапред израчунавају да би се уштедело време обраде."

#: template.py:675
msgid "Cross-Platform Support"
msgstr "Подршка за више платформи"

#: template.py:678
msgid "Multiple Platforms"
msgstr "Више платформи"

#: template.py:679
msgid ""
"Zrythm is designed to run on a {ref}wide variety of platforms and "
"architectures{endref} including x86 architectures, PowerPC, RISC-V, ARMv7 "
"and ARMv8."
msgstr ""
"Zrythm је дизајниран да ради на {ref}широком спектру платформи и "
"архитектура{endref} укључујући x86 архитектуре, PowerPC, RISC-V, ARMv7 и "
"ARMv8."

#: template.py:681
msgid "Multiple Backends"
msgstr "Више позадинских система"

#: template.py:682
msgid ""
"Support for almost all major audio and MIDI backends, including "
"JACK/PipeWire, Windows MME, WASAPI and Core Audio/MIDI."
msgstr ""
"Подршка за скоро све главне аудио и MIDI позадинске системе, укључујући JACK/"
"PipeWire, Windows MME, WASAPI и Core Audio/MIDI."

#: template.py:685
msgid "Localization"
msgstr "Локализација"

#: template.py:688
msgid "Localized UI"
msgstr "Локализован кориснички интерфејс"

#: template.py:689
msgid "Use Zrythm in your preferred language."
msgstr "Користите Zrythm на свом омиљеном језику."

#: template.py:691
msgid "Easily Add Translations"
msgstr "Лако додајте преводе"

#: template.py:692
msgid "Add missing translations and locales on {ref}Weblate{endref}."
msgstr "Додајте недостајуће преводе и локале на {ref}Weblate{endref}."

#: template.py:695
msgid "User Freedom"
msgstr "Корисничка слобода"

#: template.py:698
msgid "Free Software"
msgstr "Слободан софтвер"

#: template.py:699
msgid "All source code is released as {ref}copyleft free software{endref}."
msgstr "Сав изворни код је објављен као {ref}копилефт слободан софтвер{endref}."

#: template.py:701
msgid "Open Standards"
msgstr "Отворени стандарди"

#: template.py:702
msgid "Zrythm supports open standards such as MIDI, LV2, FLAC and OGG."
msgstr "Zrythm подржава отворене стандарде као што су MIDI, LV2, FLAC и OGG."

#: template.py:704
msgid "Cooperation"
msgstr "Сарадња"

#: template.py:705
msgid ""
"We work with the free software community to ensure Zrythm builds and runs "
"without issues on all platforms."
msgstr ""
"Сарађујемо са заједницом слободног софтвера да бисмо осигурали да Zrythm "
"ради без проблема на свим платформама."

#: template.py:713
msgid ""
"Easily select, move, resize, clone, link, loop, delete and cut objects with "
"a single tool or extend its functionality with additional specialized tools,"
" and enjoy adaptive snapping in every arranger."
msgstr ""
"Лако изаберите, померите, промените величину, клонирајте, повежите, "
"петљајте, обришите и исеците објекте са једним алатом или проширите његову "
"функционалност додатним специјализованим алатима, и уживајте у адаптивном "
"снаповању у сваком аранжеру."

#: template.py:715
msgid "Limitless Automation"
msgstr "Безгранична аутоматизација"

#: template.py:716
msgid ""
"Automate almost anything with automation events using straight lines, ramps "
"and curves, or with LFOs and envelopes."
msgstr ""
"Аутоматизујте скоро све са аутоматизационим догађајима користећи праве "
"линије, рампе и криве, или са LFO-има и омотачима."

#: template.py:719
msgid ""
"In-context listening, signal groups, FX tracks, MIDI effect and insert "
"slots, pre and post-fader aux sends and anywhere-to-anywhere routing."
msgstr ""
"Слушање у контексту, групе сигнала, FX траке, MIDI ефекти и уметање слотова, "
"пре и после фејдера аукс слања и рутирање са било ког места на било које "
"место."

#: template.py:722
msgid ""
"Generate chords from scales in the chord pad, audition and invert chords or "
"save your own chord presets, manage your chord progression in the chord "
"track and enjoy chord highlighting in the piano roll."
msgstr ""
"Генеришите акорде из скала у подлози акорда, преслушајте и инвертујте акорде "
"или сачувајте своје пресете акорда, управљајте својом прогресијом акорда у "
"траци акорда и уживајте у истицању акорда у клавирском ролу."

#: template.py:724
msgid "Audio Plugins"
msgstr "Аудио додаци"

#: template.py:725
msgid ""
"Support for every major plugin format including {lv2_ref}LV2{endref}, VST2, "
"VST3 and AU, with additional support for SFZ and SF2 soundfonts and "
"sandboxing thanks to {carla_ref}Carla{endref}."
msgstr ""

#: template.py:728
msgid ""
"Organize your work into multiple layers in the same track using track lanes,"
" quickly bounce anything to audio, import/export a wide variety of audio and"
" MIDI formats, stretch or loop any region and select from an array of track "
"types for every purpose."
msgstr ""
"Организујте свој рад у више слојева у истој траци користећи стране траке, "
"брзо пребаците било шта у аудио, увезите/извезите широк спектар аудио и MIDI "
"формата, растегните или петљајте било који регион и изаберите из низа типова "
"трака за сваку сврху."

#: template.py:731
msgid ""
"Recover your work with automatic project backups, undo almost any user "
"action and even save your undo history with projects."
msgstr ""
"Вратите свој рад са аутоматским резервним копијама пројекта, поништавајте "
"скоро сваку корисничку акцију и чак сачувајте историју поништавања са "
"пројектима."

#: template.py:733
msgid "Liberating"
msgstr "Ослобађајуће"

#: template.py:734
msgid ""
"Zrythm is {copyleft_ref}copyleft{endref} {free_software_ref}free "
"software</a> with fully auditable source code. Use, study, share and improve"
" it freely."
msgstr ""
"Zrythm је {copyleft_ref}копилефт{endref} {free_software_ref}слободан "
"софтвер</a> са потпуно проверљивим изворним кодом. Користите, проучавајте, "
"делите и побољшавајте га слободно."

