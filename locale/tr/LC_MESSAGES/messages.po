#: template.py:449
msgid ""
"DAW, digital audio workstation, music production, audio, pro audio, Linux, "
"GNU/Linux, free software, libre software, sound editor, composition, MIDI, "
"LV2, JACK, VST, audio plugin, recording, editing, arrange, arranger, mixing,"
" mastering"
msgstr ""
"DAW, dijital ses iş istasyonu, müzik prodüksiyonu, ses, profesyonel ses, "
"Linux, GNU/Linux, özgür yazılım, ses düzenleyici, kompozisyon, MIDI, LV2, "
"JACK, VST, ses eklentisi, kayıt, düzenleme, aranjman, aranjör, karıştırma, "
"mastering"

#: template.py:450
msgid "A highly automated and intuitive digital audio workstation."
msgstr "Yüksek düzeyde otomatize ve sezgisel dijital ses çalışma yeri."

#: template.py:456
msgid "Stereo dynamic range compressor"
msgstr "Stereo dinamik aralık kompresörü"

#: template.py:459
msgid "Cubic nonlinearity distortion"
msgstr "Kübik doğrusal olmayan bozulma"

#: template.py:462
msgid "Stereo flanging effect"
msgstr "Stereo flanging efekti"

#: template.py:465
msgid "Stereo signal gate"
msgstr "Stereo sinyal geçidi"

#: template.py:468
msgid "2nd-order Butterworth highpass filter"
msgstr "2. dereceden Butterworth yüksek geçiren filtre"

#: template.py:471
msgid "2nd-order Butterworth lowpass filter"
msgstr "2. dereceden Butterworth alçak geçiren filtre"

#: template.py:474
msgid "Parametric equalizer"
msgstr "Parametrik ekolayzer"

#: template.py:477
msgid "Dynamic range compressor modelled after the 1176 peak limiter"
msgstr "Dinamik aralık kompresörü 1176 tepe sınırlayıcıdan sonra modellenmiştir"

#: template.py:480
msgid "Phasing effect"
msgstr "Fazlama etkisi"

#: template.py:483
msgid "Polyphonic synthesizer with 3 detuned oscillator voices"
msgstr "Detuned 3 osilatör sesli polifonik sentezleyici"

#: template.py:486
msgid ""
"Delay that doesn't click and doesn't transpose when the delay time is "
"changed"
msgstr ""
"Gecikme süresi değiştirildiğinde tıklamayan ve transpoze olmayan gecikme"

#: template.py:489
msgid "Wah pedal effect to the 4th order"
msgstr "Wah pedalının 4. dereceye kadar etkisi"

#: template.py:492
msgid "White noise generator"
msgstr "Beyaz gürültü jeneratörü"

#: template.py:495
msgid "8x8 late-reverberation FDN reverb"
msgstr "8x8 geç reverberasyonlu FDN yankı"

#: template.py:500
msgid "ZChordz maps the chords of a minor or major scale to white keys"
msgstr "ZChordz, bir minör veya majör ölçeğin akorlarını beyaz tuşlara eşler"

#: template.py:501
msgid "Major or minor scale"
msgstr "Majör veya minör ölçek"

#: template.py:502
msgid "Velocity multiplier per note"
msgstr "Nota başına hız çarpanı"

#: template.py:505
msgid "ZLFO is a fully featured LFO for CV-based automation"
msgstr "ZLFO, CV tabanlı otomasyon için tam özellikli bir LFO'dur"

#: template.py:506
msgid "Multi-oscillator with custom wave"
msgstr "Özel dalgalı çoklu-osilatör"

#: template.py:507
msgid "Phase shift"
msgstr "Faz değişimi"

#: template.py:508
msgid "Vertical/horizontal inversion"
msgstr "Dikey/yatay inversiyon"

#: template.py:509
msgid "Step mode"
msgstr "Adım modu"

#: template.py:510
msgid "Editable range"
msgstr "Düzenlenebilir aralık"

#: template.py:511
msgid "Sync to host or free-form"
msgstr "Ana makineye veya serbest biçime senkronize edin"

#: template.py:514
msgid "ZSaw is a supersaw synth with 1 parameter"
msgstr "ZSaw 1 parametreli bir supersaw synth'dir"

#: template.py:515
msgid "7 sawtooth oscillators"
msgstr "7 testere dişi osilatör"

#: template.py:516
msgid "Single knob to control detune"
msgstr "Detune kontrolü için tek düğme"

#: template.py:527 template.py:769
msgid "Intuitive Editing"
msgstr "Sezgisel Düzenleme"

#: template.py:530
msgid "Flexible Select Tool"
msgstr "Esnek Seçim Aracı"

#: template.py:531
msgid ""
"Select, move, resize, clone, link, loop, delete and cut objects with a "
"{ref}single tool{endref}."
msgstr ""
"Nesneleri {ref}tek bir araçla seçin, taşıyın, yeniden boyutlandırın, "
"klonlayın, bağlayın, döngü oluşturun, silin ve kesin{endref}."

#: template.py:533
msgid "Extensive Toolbox"
msgstr "Kapsamlı Araç Kutusu"

#: template.py:534
msgid ""
"Extend select tool functionality by switching to the {ref}Edit, Cut, Erase, "
"Ramp or Audition tools{endref}."
msgstr ""
"Düzenle, Kes, Sil, Rampa veya Audition araçlarına{endref} geçerek seçme "
"aracı işlevselliğini genişletin."

#: template.py:536
msgid "Adaptive Snapping"
msgstr "Uyarlanabilir Yakalama"

#: template.py:537
msgid "Snapping behavior adjusts to the current zoom level."
msgstr "Yakalama davranışı geçerli yakınlaştırma düzeyine göre ayarlanır."

#: template.py:539
msgid "Looping"
msgstr "Döngü"

#: template.py:540
msgid "Loop audio, MIDI, automation and chord clips."
msgstr "Döngü sesi, MIDI, otomasyon ve akor klipleri."

#: template.py:543 template.py:784
msgid "Featureful Timeline"
msgstr "Özellikli Zaman Çizelgesi"

#: template.py:546
msgid "Track Lanes"
msgstr "Parça Şeritleri"

#: template.py:547
msgid ""
"Add multiple layers of audio/MIDI to the same track using {ref}track "
"lanes{endref}."
msgstr ""
"ref}track lanes{endref} kullanarak aynı parçaya birden fazla ses/MIDI "
"katmanı ekleyin."

#: template.py:549
msgid "Bounce in Place"
msgstr "Yerinde Zıplama"

#: template.py:550
msgid "Quickly bounce selected material to audio."
msgstr "Seçilen materyali hızlıca sese yansıtın."

#: template.py:552
msgid "Stretching"
msgstr "Esneme hareketleri"

#: template.py:553
msgid "Stretch any type of region"
msgstr "Her tür bölgeyi esnetme"

#: template.py:556
msgid "Powerful Editors"
msgstr "Güçlü Editörler"

#: template.py:559
msgid "Piano Roll"
msgstr "Piyano Rulosu"

#: template.py:560
msgid ""
"Create, edit and arrange MIDI events in a dedicated piano roll with chord "
"integration."
msgstr ""
"Akor entegrasyonu ile özel bir piyano rulosunda MIDI olayları oluşturun, "
"düzenleyin ve düzenleyin."

#: template.py:562
msgid "Drum View"
msgstr "Tambur Görünümü"

#: template.py:563
msgid "One-click switch to drum view for editing single-hit instruments."
msgstr ""
"Tek vuruşlu enstrümanları düzenlemek için davul görünümüne tek tıklamayla "
"geçiş."

#: template.py:565
msgid "Velocity Editor"
msgstr "Hız Editörü"

#: template.py:566
msgid ""
"Edit multiple velocities simultaneously with the select tool or draw with "
"the pencil or ramp tool."
msgstr ""
"Seçme aracıyla birden fazla hızı aynı anda düzenleyin veya kalem ya da rampa "
"aracıyla çizin."

#: template.py:568
msgid "Audio Editor"
msgstr "Ses Düzenleyici"

#: template.py:569
msgid ""
"Adjust fades/gain and edit parts of audio clips using audio functions inside"
" the audio editor."
msgstr ""
"Ses düzenleyicinin içindeki ses işlevlerini kullanarak solmaları/kazancı "
"ayarlayın ve ses kliplerinin bölümlerini düzenleyin."

#: template.py:571
msgid "List Editors"
msgstr "Liste Editörleri"

#: template.py:572
msgid "Edit object parameters manually in the event viewer."
msgstr "Olay görüntüleyicide nesne parametrelerini manuel olarak düzenleyin."

#: template.py:574
msgid "Editor Functions"
msgstr "Editör İşlevleri"

#: template.py:575
msgid ""
"Quickly apply functions like Legato, Invert and Fade Out to the selected "
"objects."
msgstr ""
"Seçilen nesnelere Legato, Invert ve Fade Out gibi işlevleri hızlıca "
"uygulayın."

#: template.py:577
msgid "External App Integration"
msgstr "Harici Uygulama Entegrasyonu"

#: template.py:578
msgid "Edit selected audio parts in any external app."
msgstr "Seçilen ses parçalarını herhangi bir harici uygulamada düzenleyin."

#: template.py:581
msgid "Recording Capabilities"
msgstr "Kayıt Yetenekleri"

#: template.py:584
msgid "Audio/MIDI Recording"
msgstr "Ses/MIDI Kaydı"

#: template.py:585
msgid ""
"Record audio/MIDI from any of your devices, or even from other apps using "
"JACK."
msgstr ""
"Herhangi bir cihazınızdan veya hatta JACK kullanarak diğer uygulamalardan "
"ses/MIDI kaydedin."

#: template.py:587
msgid "Comprehensive Recording Settings"
msgstr "Kapsamlı Kayıt Ayarları"

#: template.py:588
msgid ""
"Use punch in/punch out, record on MIDI input, and optionally create multiple"
" takes."
msgstr ""
"Punch in/punch out kullanın, MIDI girişine kayıt yapın ve isteğe bağlı "
"olarak birden fazla çekim oluşturun."

#: template.py:590
msgid "Automation Recording"
msgstr "Otomasyon Kaydı"

#: template.py:591
msgid "Record automation in latch/touch mode."
msgstr "Mandallı/dokunmatik modda otomasyonu kaydedin."

#: template.py:593
msgid "Device Controls"
msgstr "Cihaz Kontrolleri"

#: template.py:594
msgid ""
"Bind your device knobs to controls inside Zrythm and record your actions."
msgstr ""
"Cihaz düğmelerinizi Zrythm içindeki kontrollere bağlayın ve eylemlerinizi "
"kaydedin."

#: template.py:597 template.py:775
msgid "Mixing Capabilities"
msgstr "Karıştırma Yetenekleri"

#: template.py:600
msgid "Group Tracks"
msgstr "Grup Parçaları"

#: template.py:601
msgid "Organize audio/MIDI signal groups with group tracks."
msgstr "Grup parçaları ile ses/MIDI sinyal gruplarını düzenleyin."

#: template.py:603
msgid "Aux Sends"
msgstr "Aux Gönderimleri"

#: template.py:604
msgid "Easily route signals to FX tracks and plugin sidechain inputs."
msgstr ""
"Sinyalleri FX kanallarına ve eklenti yan zincir girişlerine kolayca "
"yönlendirin."

#: template.py:606
msgid "In-Context Listening"
msgstr "Bağlam İçinde Dinleme"

#: template.py:607
msgid ""
"Listen to specified tracks in the context of the mix by dimming down every "
"other track."
msgstr ""
"Diğer tüm parçaların sesini kısarak belirli parçaları miks bağlamında "
"dinleyin."

#: template.py:609
msgid "Monitor Section"
msgstr "İzleme Bölümü"

#: template.py:610
msgid ""
"Change listen/mute/solo behavior and adjust what goes to your speakers."
msgstr ""
"Dinleme/sessiz/solo davranışını değiştirin ve hoparlörlerinize neyin "
"gideceğini ayarlayın."

#: template.py:613
msgid "Unlimited Automation"
msgstr "Sınırsız Otomasyon"

#: template.py:616
msgid "Anywhere-to-Anywhere Connections"
msgstr "Her Yerden Her Yere Bağlantılar"

#: template.py:617
msgid "Connect anything to anything."
msgstr "Herhangi bir şeyi her şeye bağlayın."

#: template.py:619
msgid "Automation Curves"
msgstr "Otomasyon Eğrileri"

#: template.py:620
msgid ""
"Automate parameters with straight lines or curves, choosing from multiple "
"curve algorithms, such as Exponential and Elliptic curves."
msgstr ""
"Üstel ve Eliptik eğriler gibi çoklu eğri algoritmaları arasından seçim "
"yaparak düz çizgiler veya eğrilerle parametreleri otomatikleştirin."

#: template.py:622
msgid "Envelopes"
msgstr "Zarflar"

#: template.py:623
msgid ""
"Automate parameters with CV signals or envelopes, including macro knobs and "
"LFO plugins such as ZLFO."
msgstr ""
"Makro düğmeler ve ZLFO gibi LFO eklentileri dahil olmak üzere CV sinyalleri "
"veya zarflarla parametreleri otomatikleştirin."

#: template.py:625
msgid "Automate Anything"
msgstr "Her Şeyi Otomatikleştirin"

#: template.py:626
msgid ""
"Automate any possible parameter, including the project's BPM and time "
"signature."
msgstr ""
"Projenin BPM'si ve zaman imzası da dahil olmak üzere olası tüm parametreleri "
"otomatikleştirin."

#: template.py:629
msgid "Intuitive User Interface"
msgstr "Sezgisel Kullanıcı Arayüzü"

#: template.py:632
msgid "Detachable Views"
msgstr "Ayrılabilir Görünümler"

#: template.py:633
msgid ""
"Detach views from any panel and work efficiently with multi-monitor setups."
msgstr ""
"Görünümleri herhangi bir panelden ayırın ve çoklu monitör kurulumlarıyla "
"verimli bir şekilde çalışın."

#: template.py:635
msgid "Searchable Preferences"
msgstr "Aranabilir Tercihler"

#: template.py:636
msgid "Start typing to locate the preference you're looking for."
msgstr "Aradığınız tercihi bulmak için yazmaya başlayın."

#: template.py:638
msgid "Inspector Pages"
msgstr "Müfettiş Sayfaları"

#: template.py:639
msgid "Edit all track and plugin parameters in the inspector."
msgstr "Denetçideki tüm parça ve eklenti parametrelerini düzenleyin."

#: template.py:642
msgid "Plugin Capabilities"
msgstr "Eklenti Yetenekleri"

#: template.py:645
msgid "Plugin Support"
msgstr "Eklenti Desteği"

#: template.py:646
msgid ""
"Thanks to {ref}Carla{endref}, Zrythm supports a variety of plugin formats "
"including LV2, VST2, VST3, AU, CLAP and JSFX."
msgstr ""
"ref}Carla{endref} sayesinde Zrythm, LV2, VST2, VST3, AU, CLAP ve JSFX dahil "
"olmak üzere çeşitli eklenti formatlarını destekler."

#: template.py:648
msgid "SoundFonts as Plugins"
msgstr "Eklenti Olarak SoundFonts"

#: template.py:649
msgid "Use SFZ and SF2 soundfonts as instrument plugins."
msgstr "SFZ ve SF2 soundfontlarını enstrüman eklentileri olarak kullanın."

#: template.py:651
msgid "Flexible Plugin Browser"
msgstr "Esnek Eklenti Tarayıcısı"

#: template.py:652
msgid ""
"Easily filter plugins by author, format or category, and organize your "
"favorite plugins with plugin collections."
msgstr ""
"Eklentileri yazara, biçime veya kategoriye göre kolayca filtreleyin ve "
"favori eklentilerinizi eklenti koleksiyonları ile düzenleyin."

#: template.py:654
msgid "Plugin Bridging"
msgstr "Eklenti Köprüleme"

#: template.py:655
msgid "Sandbox plugins by opening them in bridge mode."
msgstr "Eklentileri köprü modunda açarak sandbox yapın."

#: template.py:657
msgid "Automatable Bypass Mode"
msgstr "Otomatikleştirilebilir Bypass Modu"

#: template.py:658
msgid "Easily bypass plugins in the signal chain with an automatable control."
msgstr ""
"Otomatikleştirilebilir bir kontrol ile sinyal zincirindeki eklentileri "
"kolayca bypass edin."

#: template.py:661
msgid "Comprehensive Import/Export"
msgstr "Kapsamlı İthalat/İhracat"

#: template.py:664
msgid "File Browser"
msgstr "Dosya Tarayıcı"

#: template.py:665
msgid ""
"Browse and audition MIDI and audio files, and organize your favorite paths "
"with favorites."
msgstr ""
"MIDI ve ses dosyalarına göz atın, bunları denetleyin ve favori yollarınızı "
"favorilerle düzenleyin."

#: template.py:667
msgid "Audio Files"
msgstr "Ses Dosyaları"

#: template.py:668
msgid ""
"Import or export any format supported by {ref}libsndfile{endref}, with "
"additional MP3 import support."
msgstr ""
"Ek MP3 içe aktarma desteği ile {ref}libsndfile{endref} tarafından "
"desteklenen herhangi bir formatı içe veya dışa aktarın."

#: template.py:670
msgid "MIDI"
msgstr "MIDI"

#: template.py:671
msgid ""
"Import or export any part of the project in MIDI Type 0 or Type 1 formats."
msgstr ""
"Projenin herhangi bir bölümünü MIDI Tip 0 veya Tip 1 formatlarında içe veya "
"dışa aktarın."

#: template.py:673
msgid "Stem Export"
msgstr "Kök Dışa Aktarma"

#: template.py:674
msgid "Export stems for specific tracks and share them with other producers."
msgstr ""
"Belirli parçalar için stemleri dışa aktarın ve diğer yapımcılarla paylaşın."

#: template.py:677 template.py:778
msgid "Chord Assistance"
msgstr "Akor Desteği"

#: template.py:680
msgid "Chord Audition"
msgstr "Akor Seçmeleri"

#: template.py:681
msgid ""
"Quickly listen to chords by clicking the pads or pressing notes on your MIDI"
" keyboard, and drag-and-drop chords to the timeline."
msgstr ""
"Pedlere tıklayarak veya MIDI klavyenizdeki notalara basarak akorları hızlıca "
"dinleyin ve akorları zaman çizelgesine sürükleyip bırakın."

#: template.py:683
msgid "Chord Editing"
msgstr "Akor Düzenleme"

#: template.py:684
msgid ""
"Invert chords with a single click or use the chord selector to choose any "
"chord, with an option to filter chords in the current scale."
msgstr ""
"Tek bir tıklama ile akorları ters çevirin veya mevcut skaladaki akorları "
"filtreleme seçeneği ile herhangi bir akoru seçmek için akor seçiciyi "
"kullanın."

#: template.py:686
msgid "Recordable Chord Track"
msgstr "Kaydedilebilir Akor Parçası"

#: template.py:687
msgid ""
"Dictate or record the scale and chord progression of the project, and "
"optionally route the output to an instrument."
msgstr ""
"Projenin ölçeğini ve akor ilerleyişini dikte edin veya kaydedin ve isteğe "
"bağlı olarak çıktıyı bir enstrümana yönlendirin."

#: template.py:689
msgid "Chord Presets"
msgstr "Akor Ön Ayarları"

#: template.py:690
msgid ""
"Generate chords from a wide range of scales, load included chord presets for"
" various genres, or save your own."
msgstr ""
"Çok çeşitli skalalardan akorlar oluşturun, çeşitli türler için dahil edilen "
"akor ön ayarlarını yükleyin veya kendi akorlarınızı kaydedin."

#: template.py:693 template.py:787
msgid "Never Lose Work"
msgstr "Asla İş Kaybetmeyin"

#: template.py:696
msgid "Project Backups"
msgstr "Proje Yedekleri"

#: template.py:697
msgid "Backups taken automatically at user-specified intervals."
msgstr ""
"Yedeklemeler kullanıcı tarafından belirlenen aralıklarla otomatik olarak "
"alınır."

#: template.py:699
msgid "Undoable Actions"
msgstr "Geri Alınamayan Eylemler"

#: template.py:700
msgid "Almost every user action is undoable."
msgstr "Neredeyse her kullanıcı eylemi geri alınabilir."

#: template.py:702
msgid "Serializable Undo History"
msgstr "Serializable Geri Alma Geçmişi"

#: template.py:703
msgid "Keep your undo history when saving projects."
msgstr "Projeleri kaydederken geri alma geçmişinizi saklayın."

#: template.py:706
msgid "Scripting"
msgstr "Scripting"

#: template.py:709
msgid "Extend Zrythm"
msgstr "Zrythm'i Genişletin"

#: template.py:710
msgid ""
"Extend the capabilities of Zrythm by editing its state using {ref}GNU Guile "
"scripts{endref}."
msgstr ""
"Zrythm'in yeteneklerini, {ref}GNU Guile betiklerini{endref} kullanarak "
"durumunu düzenleyerek genişletin."

#: template.py:712
msgid "Custom Editor Functions"
msgstr "Özel Editör İşlevleri"

#: template.py:713
msgid "Implement your own MIDI/audio/automation functions (coming soon)."
msgstr "Kendi MIDI/ses/otomasyon fonksiyonlarınızı uygulayın (çok yakında)."

#: template.py:715
msgid "Project Generation"
msgstr "Proje Üretimi"

#: template.py:716
msgid "Generate projects with GNU Guile scripts."
msgstr "GNU Guile betikleri ile projeler oluşturun."

#: template.py:719
msgid "Optimized Performance"
msgstr "Optimize Edilmiş Performans"

#: template.py:722
msgid "Hardware accelerated UI"
msgstr "Donanım hızlandırmalı kullanıcı arayüzü"

#: template.py:723
msgid ""
"Most of the user interface is drawn on the GPU thanks to {ref}GTK4{endref}."
msgstr ""
"Kullanıcı arayüzünün büyük bir kısmı {ref}GTK4{endref} sayesinde GPU "
"üzerinde çizilmektedir."

#: template.py:725
msgid "SIMD-optimized DSP"
msgstr "SIMD için optimize edilmiş DSP"

#: template.py:726
msgid ""
"Zrythm uses {ref}lsp-dsp-lib{endref} which implements SIMD extensions such "
"as SSE, AVX and FMA when available to speed up audio processing and minimize"
" DSP usage."
msgstr ""
"Zrythm, ses işlemeyi hızlandırmak ve DSP kullanımını en aza indirmek için "
"mevcut olduğunda SSE, AVX ve FMA gibi SIMD uzantılarını uygulayan {ref}lsp-"
"dsp-lib{endref} kullanır."

#: template.py:728
msgid "Extensive Caching"
msgstr "Kapsamlı Önbellekleme"

#: template.py:729
msgid "Expensive computations are pre-calculated to save processing time."
msgstr ""
"İşlem süresinden tasarruf etmek için pahalı hesaplamalar önceden hesaplanır."

#: template.py:732
msgid "Cross-Platform Support"
msgstr "Çapraz Platform Desteği"

#: template.py:735
msgid "Multiple Platforms"
msgstr "Çoklu Platformlar"

#: template.py:736
msgid ""
"Zrythm is designed to run on a {ref}wide variety of platforms and "
"architectures{endref} including x86 architectures, PowerPC, RISC-V, ARMv7 "
"and ARMv8."
msgstr ""
"Zrythm, x86 mimarileri, PowerPC, RISC-V, ARMv7 ve ARMv8 dahil olmak üzere "
"{ref}çok çeşitli platformlarda ve mimarilerde{endref} çalışacak şekilde "
"tasarlanmıştır."

#: template.py:738
msgid "Multiple Backends"
msgstr "Çoklu Arka Uçlar"

#: template.py:739
msgid ""
"Support for almost all major audio and MIDI backends, including "
"JACK/PipeWire, Windows MME, WASAPI and Core Audio/MIDI."
msgstr ""
"JACK/PipeWire, Windows MME, WASAPI ve Core Audio/MIDI dahil olmak üzere "
"neredeyse tüm büyük ses ve MIDI arka uçları için destek."

#: template.py:742
msgid "Localization"
msgstr "Yerelleştirme"

#: template.py:745
msgid "Localized UI"
msgstr "Yerelleştirilmiş Kullanıcı Arayüzü"

#: template.py:746
msgid "Use Zrythm in your preferred language."
msgstr "Zrythm'i tercih ettiğiniz dilde kullanın."

#: template.py:748
msgid "Easily Add Translations"
msgstr "Kolayca Çeviri Ekleyin"

#: template.py:749
msgid "Add missing translations and locales on {ref}Weblate{endref}."
msgstr ""
"Eksik çevirileri ve yerel ayarları {ref}Weblate{endref} üzerine ekleyin."

#: template.py:752
msgid "User Freedom"
msgstr "Kullanıcı Özgürlüğü"

#: template.py:755
msgid "Free Software"
msgstr "Özgür Yazılım"

#: template.py:756
msgid "All source code is released as {ref}copyleft free software{endref}."
msgstr ""
"Tüm kaynak kodu {ref}copyleft özgür yazılım{endref} olarak yayınlanmaktadır."

#: template.py:758
msgid "Open Standards"
msgstr "Açık Standartlar"

#: template.py:759
msgid "Zrythm supports open standards such as MIDI, LV2, FLAC and OGG."
msgstr "Zrythm, MIDI, LV2, FLAC ve OGG gibi açık standartları destekler."

#: template.py:761
msgid "Cooperation"
msgstr "İşbirliği"

#: template.py:762
msgid ""
"We work with the free software community to ensure Zrythm builds and runs "
"without issues on all platforms."
msgstr ""
"Zrythm'in tüm platformlarda sorunsuz bir şekilde oluşturulmasını ve "
"çalışmasını sağlamak için özgür yazılım topluluğuyla birlikte çalışıyoruz."

#: template.py:770
msgid ""
"Easily select, move, resize, clone, link, loop, delete and cut objects with "
"a single tool or extend its functionality with additional specialized tools,"
" and enjoy adaptive snapping in every arranger."
msgstr ""
"Tek bir araçla nesneleri kolayca seçin, taşıyın, yeniden boyutlandırın, "
"klonlayın, bağlayın, döngü oluşturun, silin ve kesin ya da ek özel araçlarla "
"işlevselliğini artırın ve her düzenleyicide uyarlanabilir yapışmanın keyfini "
"çıkarın."

#: template.py:772
msgid "Limitless Automation"
msgstr "Sınırsız Otomasyon"

#: template.py:773
msgid ""
"Automate almost anything with automation events using straight lines, ramps "
"and curves, or with LFOs and envelopes."
msgstr ""
"Düz çizgiler, rampalar ve eğriler kullanarak otomasyon olaylarıyla veya "
"LFO'lar ve zarflarla neredeyse her şeyi otomatikleştirin."

#: template.py:776
msgid ""
"In-context listening, signal groups, FX tracks, MIDI effect and insert "
"slots, pre and post-fader aux sends and anywhere-to-anywhere routing."
msgstr ""
"Bağlam içi dinleme, sinyal grupları, FX kanalları, MIDI efekt ve insert "
"yuvaları, pre ve post-fader aux gönderimleri ve her yerden her yere "
"yönlendirme."

#: template.py:779
msgid ""
"Generate chords from scales in the chord pad, audition and invert chords or "
"save your own chord presets, manage your chord progression in the chord "
"track and enjoy chord highlighting in the piano roll."
msgstr ""
"Akor pedinde gamlardan akorlar oluşturun, akorları dinleyin ve ters çevirin "
"veya kendi akor ön ayarlarınızı kaydedin, akor izinde akor ilerlemenizi "
"yönetin ve piyano rulosunda akor vurgulamanın keyfini çıkarın."

#: template.py:781
msgid "Audio Plugins"
msgstr "Ses Eklentileri"

#: template.py:782
msgid ""
"Support for every major plugin format including {lv2_ref}LV2{endref}, VST2, "
"VST3, AU, CLAP and JSFX, with additional support for SFZ and SF2 soundfonts "
"and sandboxing thanks to {carla_ref}Carla{endref}."
msgstr ""
"lv2_ref}LV2{endref}, VST2, VST3, AU, CLAP ve JSFX dahil olmak üzere her ana "
"eklenti formatı için destek, SFZ ve SF2 ses yazı tipleri için ek destek ve "
"{carla_ref}Carla{endref} sayesinde sandboxing."

#: template.py:785
msgid ""
"Organize your work into multiple layers in the same track using track lanes,"
" quickly bounce anything to audio, import/export a wide variety of audio and"
" MIDI formats, stretch or loop any region and select from an array of track "
"types for every purpose."
msgstr ""
"Parça şeritlerini kullanarak çalışmanızı aynı parçada birden fazla katman "
"halinde düzenleyin, her şeyi hızlı bir şekilde sese aktarın, çok çeşitli ses "
"ve MIDI formatlarını içe/dışa aktarın, herhangi bir bölgeyi uzatın veya "
"döngüye alın ve her amaca uygun bir dizi parça türü arasından seçim yapın."

#: template.py:788
msgid ""
"Recover your work with automatic project backups, undo almost any user "
"action and even save your undo history with projects."
msgstr ""
"Otomatik proje yedeklemeleri ile çalışmanızı kurtarın, neredeyse tüm "
"kullanıcı eylemlerini geri alın ve hatta geri alma geçmişinizi projelerle "
"kaydedin."

#: template.py:790
msgid "Liberating"
msgstr "Özgürleştirici"

#: template.py:791
msgid ""
"Zrythm is {copyleft_ref}copyleft{endref} {free_software_ref}free "
"software</a> with fully auditable source code. Use, study, share and improve"
" it freely."
msgstr ""
"Zrythm, tamamen denetlenebilir kaynak koduna sahip "
"{copyleft_ref}copyleft{endref} {free_software_ref}ücretsiz bir yazılımdır</"
"a>. Özgürce kullanın, inceleyin, paylaşın ve geliştirin."

