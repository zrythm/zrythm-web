#: template.py:492
msgid ""
"DAW, digital audio workstation, music production, audio, pro audio, Linux, "
"GNU/Linux, free software, libre software, sound editor, composition, MIDI, "
"LV2, JACK, VST, audio plugin, recording, editing, arrange, arranger, mixing,"
" mastering"
msgstr ""
"DAW, workstation audio digitale, produzione musicale, audio, audio "
"professionale, Linux, GNU/Linux, software libero, software libero, editor "
"audio, composizione, MIDI, LV2, JACK, VST, plugin audio, registrazione, "
"modifica, arrangiamento, arrangiatore, missaggio, mastering"

#: template.py:493
msgid "A highly automated and intuitive digital audio workstation."
msgstr "Una digital audio workstation altamente automatizzata e intuitiva."

#: template.py:499
msgid "Stereo dynamic range compressor"
msgstr "Compressore di gamma dinamica stereo"

#: template.py:502
msgid "Cubic nonlinearity distortion"
msgstr "Distorsione di non linearità cubica"

#: template.py:505
msgid "Stereo flanging effect"
msgstr "Effetto flanger stereo"

#: template.py:508
msgid "Stereo signal gate"
msgstr "Gate segnale stereo"

#: template.py:511
msgid "2nd-order Butterworth highpass filter"
msgstr "Filtro passa-alto Butterworth di 2° ordine"

#: template.py:514
msgid "2nd-order Butterworth lowpass filter"
msgstr "Filtro passa-basso Butterworth di 2° ordine"

#: template.py:517
msgid "Parametric equalizer"
msgstr "Equalizzatore parametrico"

#: template.py:520
msgid "Dynamic range compressor modelled after the 1176 peak limiter"
msgstr "Compressore di gamma dinamica modellato sul limitatore di picco 1176"

#: template.py:523
msgid "Phasing effect"
msgstr "Effetto phasing"

#: template.py:526
msgid "Polyphonic synthesizer with 3 detuned oscillator voices"
msgstr "Sintetizzatore polifonico con 3 voci oscillanti scordate"

#: template.py:529
msgid ""
"Delay that doesn't click and doesn't transpose when the delay time is "
"changed"
msgstr ""
"Ritardo che non fa clic e non si traspone quando si modifica il tempo di "
"ritardo"

#: template.py:532
msgid "Wah pedal effect to the 4th order"
msgstr "Effetto pedale wah al 4° ordine"

#: template.py:535
msgid "White noise generator"
msgstr "Generatore di rumore bianco"

#: template.py:538
msgid "8x8 late-reverberation FDN reverb"
msgstr "Riverbero FDN a riverberazione tardiva 8x8"

#: template.py:543
msgid "ZChordz maps the chords of a minor or major scale to white keys"
msgstr ""
"ZChordz mappa gli accordi di una scala minore o maggiore sui tasti bianchi"

#: template.py:544
msgid "Major or minor scale"
msgstr "Scala maggiore o minore"

#: template.py:545
msgid "Velocity multiplier per note"
msgstr "Moltiplicatore di velocità per nota"

#: template.py:548
msgid "ZLFO is a fully featured LFO for CV-based automation"
msgstr "ZLFO è un LFO completo per l'automazione basata su CV"

#: template.py:549
msgid "Multi-oscillator with custom wave"
msgstr "Multi-oscillatore con onda personalizzata"

#: template.py:550
msgid "Phase shift"
msgstr "Spostamento di fase"

#: template.py:551
msgid "Vertical/horizontal inversion"
msgstr "Inversione verticale/orizzontale"

#: template.py:552
msgid "Step mode"
msgstr "Modalità passo"

#: template.py:553
msgid "Editable range"
msgstr "Intervallo modificabile"

#: template.py:554
msgid "Sync to host or free-form"
msgstr "Sincronizzazione con l'host o formato libero"

#: template.py:557
msgid "ZSaw is a supersaw synth with 1 parameter"
msgstr "ZSaw è un sintetizzatore supersaw con 1 parametro"

#: template.py:558
msgid "7 sawtooth oscillators"
msgstr "7 oscillatori a denti di sega"

#: template.py:559
msgid "Single knob to control detune"
msgstr "Singola manopola per controllare la disintonazione"

#: template.py:570 template.py:812
msgid "Intuitive Editing"
msgstr "Modifica intuitiva"

#: template.py:573
msgid "Flexible Select Tool"
msgstr "Strumento di selezione flessibile"

#: template.py:574
#, python-brace-format
msgid ""
"Select, move, resize, clone, link, loop, delete and cut objects with a "
"{ref}single tool{endref}."
msgstr ""
"Seleziona, sposta, ridimensiona, clona, collega, crea cicli, elimina e "
"taglia oggetti con un {ref}singolo strumento{endref}."

#: template.py:576
msgid "Extensive Toolbox"
msgstr "Ampia cassetta attrezzi"

#: template.py:577
#, python-brace-format
msgid ""
"Extend select tool functionality by switching to the {ref}Edit, Cut, Erase, "
"Ramp or Audition tools{endref}."
msgstr ""
"Estendi la funzionalità dello strumento di selezione passando agli strumenti"
" {ref}Modifica, Taglia, Cancella, Rampa o Audition{endref}."

#: template.py:579
msgid "Adaptive Snapping"
msgstr "Aggancio adattivo"

#: template.py:580
msgid "Snapping behavior adjusts to the current zoom level."
msgstr ""
"Il comportamento di aggancio si adatta al livello dello zoom corrente."

#: template.py:582
msgid "Looping"
msgstr "Ciclazione"

#: template.py:583
msgid "Loop audio, MIDI, automation and chord clips."
msgstr "Cicli audio, MIDI, automazione e clip di accordi."

#: template.py:586 template.py:827
msgid "Featureful Timeline"
msgstr "Linea temporale con funzionalità"

#: template.py:589
msgid "Track Lanes"
msgstr "Corsie delle tracce"

#: template.py:590
#, python-brace-format
msgid ""
"Add multiple layers of audio/MIDI to the same track using {ref}track "
"lanes{endref}."
msgstr ""
"Aggiungi vari livelli di audio/MIDI alla stessa traccia con le "
"{ref}corsie{endref}."

#: template.py:592
msgid "Bounce in Place"
msgstr ""

#: template.py:593
msgid "Quickly bounce selected material to audio."
msgstr ""

#: template.py:595
msgid "Stretching"
msgstr "Stiramento"

#: template.py:596
msgid "Stretch any type of region"
msgstr "Stira ogni tipo di regione"

#: template.py:599
msgid "Powerful Editors"
msgstr "Editor potenti"

#: template.py:602
msgid "Piano Roll"
msgstr "Piano Roll"

#: template.py:603
msgid ""
"Create, edit and arrange MIDI events in a dedicated piano roll with chord "
"integration."
msgstr ""
"Crea, modifica e organizza eventi MIDI in un piano roll dedicato con accordi"
" integrati."

#: template.py:605
msgid "Drum View"
msgstr "Vista Percussioni"

#: template.py:606
msgid "One-click switch to drum view for editing single-hit instruments."
msgstr ""
"Passa alla visuale percussioni con un clic per comporre con strumenti a "
"colpo singolo."

#: template.py:608
msgid "Velocity Editor"
msgstr "Editor velocità"

#: template.py:609
msgid ""
"Edit multiple velocities simultaneously with the select tool or draw with "
"the pencil or ramp tool."
msgstr ""
"Modifica contemporaneamente più velocità con lo strumento selezione o "
"disegnale con la matita o la rampa."

#: template.py:611
msgid "Audio Editor"
msgstr "Editor audio"

#: template.py:612
msgid ""
"Adjust fades/gain and edit parts of audio clips using audio functions inside"
" the audio editor."
msgstr ""
"Regola dissolvenze/guadagno e modifica clip sonore grazie alle funzioni "
"dell'editor audio."

#: template.py:614
msgid "List Editors"
msgstr "Editor a lista"

#: template.py:615
msgid "Edit object parameters manually in the event viewer."
msgstr "Modifica manualmente i parametri nel visualizzatore eventi."

#: template.py:617
msgid "Editor Functions"
msgstr "Funzioni dell'editor"

#: template.py:618
msgid ""
"Quickly apply functions like Legato, Invert and Fade Out to the selected "
"objects."
msgstr ""
"Applica velocemente funzioni come legato, inversione e dissolvenza in uscita"
" agli oggetti selezionati."

#: template.py:620
msgid "External App Integration"
msgstr "Integrazione con app esterne"

#: template.py:621
msgid "Edit selected audio parts in any external app."
msgstr "Modifica parti audio selezionate in qualsiasi app esterna."

#: template.py:624
msgid "Recording Capabilities"
msgstr "Capacità di registrazione"

#: template.py:627
msgid "Audio/MIDI Recording"
msgstr "Registra audio/MIDI"

#: template.py:628
msgid ""
"Record audio/MIDI from any of your devices, or even from other apps using "
"JACK."
msgstr ""
"Registra audio/MIDI da qualsiasi dei tuoi dispositivi, o perfino da altre "
"app attraverso JACK."

#: template.py:630
msgid "Comprehensive Recording Settings"
msgstr "Impostazioni di registrazione complete"

#: template.py:631
msgid ""
"Use punch in/punch out, record on MIDI input, and optionally create multiple"
" takes."
msgstr ""
"Usa punch in/punch out, registra su ingressi MIDI e salva varie prove dello "
"stesso pezzo."

#: template.py:633
msgid "Automation Recording"
msgstr ""

#: template.py:634
msgid "Record automation in latch/touch mode."
msgstr ""

#: template.py:636
msgid "Device Controls"
msgstr ""

#: template.py:637
msgid ""
"Bind your device knobs to controls inside Zrythm and record your actions."
msgstr ""

#: template.py:640 template.py:818
msgid "Mixing Capabilities"
msgstr ""

#: template.py:643
msgid "Group Tracks"
msgstr ""

#: template.py:644
msgid "Organize audio/MIDI signal groups with group tracks."
msgstr ""

#: template.py:646
msgid "Aux Sends"
msgstr ""

#: template.py:647
msgid "Easily route signals to FX tracks and plugin sidechain inputs."
msgstr ""

#: template.py:649
msgid "In-Context Listening"
msgstr ""

#: template.py:650
msgid ""
"Listen to specified tracks in the context of the mix by dimming down every "
"other track."
msgstr ""

#: template.py:652
msgid "Monitor Section"
msgstr ""

#: template.py:653
msgid ""
"Change listen/mute/solo behavior and adjust what goes to your speakers."
msgstr ""

#: template.py:656
msgid "Unlimited Automation"
msgstr ""

#: template.py:659
msgid "Anywhere-to-Anywhere Connections"
msgstr ""

#: template.py:660
msgid "Connect anything to anything."
msgstr "Collega qualsiasi cosa a qualsiasi cosa."

#: template.py:662
msgid "Automation Curves"
msgstr ""

#: template.py:663
msgid ""
"Automate parameters with straight lines or curves, choosing from multiple "
"curve algorithms, such as Exponential and Elliptic curves."
msgstr ""

#: template.py:665
msgid "Envelopes"
msgstr ""

#: template.py:666
msgid ""
"Automate parameters with CV signals or envelopes, including macro knobs and "
"LFO plugins such as ZLFO."
msgstr ""

#: template.py:668
msgid "Automate Anything"
msgstr ""

#: template.py:669
msgid ""
"Automate any possible parameter, including the project's BPM and time "
"signature."
msgstr ""

#: template.py:672
msgid "Intuitive User Interface"
msgstr ""

#: template.py:675
msgid "Detachable Views"
msgstr ""

#: template.py:676
msgid ""
"Detach views from any panel and work efficiently with multi-monitor setups."
msgstr ""

#: template.py:678
msgid "Searchable Preferences"
msgstr ""

#: template.py:679
msgid "Start typing to locate the preference you're looking for."
msgstr ""

#: template.py:681
msgid "Inspector Pages"
msgstr ""

#: template.py:682
msgid "Edit all track and plugin parameters in the inspector."
msgstr ""

