msgid ""
"Delay that doesn't click and doesn't transpose when the delay time is "
"changed"
msgstr ""
"Delay that doesn't klicka and doesn't transpose when the delay time is ändrad"

#: template.py:489
msgid "Wah pedal effect to the 4th order"
msgstr "Wah pedal effekt till den 4:e ordningen"

#: template.py:492
msgid "White noise generator"
msgstr "Vitt brus generator"

#: template.py:495
msgid "8x8 late-reverberation FDN reverb"
msgstr "8x8 FDN reverb med sen reverb"

#: template.py:500
msgid "ZChordz maps the chords of a minor or major scale to white keys"
msgstr ""
"ZChordz översätter ackorden från en moll- eller durskala till vita tangenter"

#: template.py:501
msgid "Major or minor scale"
msgstr "Mindre eller större skala"

#: template.py:502
msgid "Velocity multiplier per note"
msgstr "Hastighets multiplikator per not"

#: template.py:505
msgid "ZLFO is a fully featured LFO for CV-based automation"
msgstr "ZLFO är en fullt funktionsrik LFO för CV-baserad automation."

#: template.py:506
msgid "Multi-oscillator with custom wave"
msgstr "Multi-oscillator med justerbar våg"

#: template.py:507
msgid "Phase shift"
msgstr "Fasförskjutning"

#: template.py:508
msgid "Vertical/horizontal inversion"
msgstr "Vertikal/horisontell inversion"

#: template.py:509
msgid "Step mode"
msgstr "Stegläge"

#: template.py:510
msgid "Editable range"
msgstr "Redigeraabell range"

#: template.py:511
msgid "Sync to host or free-form"
msgstr ""

#: template.py:514
msgid "ZSaw is a supersaw synth with 1 parameter"
msgstr "ZSaw is a suppersaw synth with 1 parameter"

#: template.py:515
msgid "7 sawtooth oscillators"
msgstr "7 sågtandsoscillatorer"

#: template.py:516
msgid "Single knob to control detune"
msgstr "Single knejb to kontroll detune"

#: template.py:527 template.py:769
msgid "Intuitive Editing"
msgstr "Intuitive Redigeraing"

#: template.py:530
msgid "Flexible Select Tool"
msgstr "Flexible Välj Verktyg"

#: template.py:531
msgid ""
"Select, move, resize, clone, link, loop, delete and cut objects with a "
"{ref}single tool{endref}."
msgstr ""
"Välj, move, restorlek, clone, länk, loop, delete and cut objekts with a {ref}"
"single verktyg{slutref}."

#: template.py:533
msgid "Extensive Toolbox"
msgstr "Extensive Verktygbox"

#: template.py:534
msgid ""
"Extend select tool functionality by switching to the {ref}Edit, Cut, Erase, "
"Ramp or Audition tools{endref}."
msgstr ""
"Extslut välj verktyg funktionality by switching to the {ref}Redigera, Klipp "
"ut, Erase, Ramp or Audition verktygs{endref}."

#: template.py:536
msgid "Adaptive Snapping"
msgstr "Adaptiv Snapping"

#: template.py:537
msgid "Snapping behavior adjusts to the current zoom level."
msgstr "Snapping behavior adbaras to the current zoom nivå."

#: template.py:539
msgid "Looping"
msgstr "Slingaing"

#: template.py:540
msgid "Loop audio, MIDI, automation and chord clips."
msgstr "Slinga ljud, MIDI, automation and ackord clips."

#: template.py:543 template.py:784
msgid "Featureful Timeline"
msgstr "Featureful Tidslinje"

#: template.py:546
msgid "Track Lanes"
msgstr "Spår Lanes"

#: template.py:547
msgid ""
"Add multiple layers of audio/MIDI to the same track using {ref}track "
"lanes{endref}."
msgstr ""
"Lägg till multiple layers of ljud/MIDI to the samma spår using {ref}spår "
"lanes{slutref}."

#: template.py:549
msgid "Bounce in Place"
msgstr "Renderaa in Place"

#: template.py:550
msgid "Quickly bounce selected material to audio."
msgstr "Quickly bounce väljed material to ljud."

#: template.py:552
msgid "Stretching"
msgstr "Sträckning"

#: template.py:553
msgid "Stretch any type of region"
msgstr "Stretch vilken som helst typ of region"

#: template.py:556
msgid "Powerful Editors"
msgstr "Powerful Redigeraors"

#: template.py:559
msgid "Piano Roll"
msgstr "Pianej Roll"

#: template.py:560
msgid ""
"Create, edit and arrange MIDI events in a dedicated piano roll with chord "
"integration."
msgstr ""
"Skapa, edit and arrange MIDI events in a dedicated pianej roll with ackord "
"integration."

#: template.py:562
msgid "Drum View"
msgstr "Drum Visa"

#: template.py:563
msgid "One-click switch to drum view for editing single-hit instruments."
msgstr "One-klicka switch to drum view for editing single-hit instruments."

#: template.py:565
msgid "Velocity Editor"
msgstr "Velocity Redigeraor"

#: template.py:566
msgid ""
"Edit multiple velocities simultaneously with the select tool or draw with "
"the pencil or ramp tool."
msgstr ""
"Redigera multiple velocities simultaneously with the välj verktyg or draw "
"with the pencil or ramp verktyg."

#: template.py:568
msgid "Audio Editor"
msgstr "Ljud Redigeraor"

#: template.py:569
msgid ""
"Adjust fades/gain and edit parts of audio clips using audio functions inside"
" the audio editor."
msgstr ""
"Adbara fades/gain and edit parts of ljud clips using ljud funktions inside "
"the ljud editor."

#: template.py:571
msgid "List Editors"
msgstr "Lista Redigeraors"

#: template.py:572
msgid "Edit object parameters manually in the event viewer."
msgstr "Redigera objekt parameters manuelllay in the event viewer."

#: template.py:574
msgid "Editor Functions"
msgstr "Redigeraor Funktions"

#: template.py:575
msgid ""
"Quickly apply functions like Legato, Invert and Fade Out to the selected "
"objects."
msgstr ""
"Quickly apply funktions like Legato, Invert and Fade Out to the väljed "
"objekts."

#: template.py:577
msgid "External App Integration"
msgstr "Extern App Integration"

#: template.py:578
msgid "Edit selected audio parts in any external app."
msgstr "Redigera väljed ljud parts in vilken som helst extern app."

#: template.py:581
msgid "Recording Capabilities"
msgstr "Spela ining Capabilities"

#: template.py:584
msgid "Audio/MIDI Recording"
msgstr "Ljud/MIDI Spela ining"

#: template.py:585
msgid ""
"Record audio/MIDI from any of your devices, or even from other apps using "
"JACK."
msgstr ""
"Spela in ljud/MIDI from vilken som helst of your devices, or even from annan "
"apps using JACK."

#: template.py:587
msgid "Comprehensive Recording Settings"
msgstr "Comprehensive Spela ining Inställningar"

#: template.py:588
msgid ""
"Use punch in/punch out, record on MIDI input, and optionally create multiple"
" takes."
msgstr ""
"Use punch in/punch out, record on MIDI inmatning, and alternativallay create "
"multiple takes."

#: template.py:590
msgid "Automation Recording"
msgstr "Automation Spela ining"

#: template.py:591
msgid "Record automation in latch/touch mode."
msgstr "Spela in automation in latch/touch mode."

#: template.py:593
msgid "Device Controls"
msgstr "Device Kontrolls"

#: template.py:594
msgid ""
"Bind your device knobs to controls inside Zrythm and record your actions."
msgstr ""
"Bind your device knejbs to kontrolls inside Zrythm and record your åtgärds."

#: template.py:597 template.py:775
msgid "Mixing Capabilities"
msgstr ""

#: template.py:600
msgid "Group Tracks"
msgstr "Grupppera Spårs"

#: template.py:601
msgid "Organize audio/MIDI signal groups with group tracks."
msgstr "Organize ljud/MIDI signal gruppperas with grupppera spårs."

#: template.py:603
msgid "Aux Sends"
msgstr "Aux Ssluts"

#: template.py:604
msgid "Easily route signals to FX tracks and plugin sidechain inputs."
msgstr ""
"Easily route signals to FX spårs and insticksmodul sidechain inmatnings."

#: template.py:606
msgid "In-Context Listening"
msgstr "In-Context Listaening"

#: template.py:607
msgid ""
"Listen to specified tracks in the context of the mix by dimming down every "
"other track."
msgstr ""
"Listaen to specified spårs in the context of the mix by dimming ner varje "
"annan spår."

#: template.py:609
msgid "Monitor Section"
msgstr ""

#: template.py:610
msgid ""
"Change listen/mute/solo behavior and adjust what goes to your speakers."
msgstr ""
"Change listaen/tysta/solo behavior and adbara what goes to your speakers."

#: template.py:613
msgid "Unlimited Automation"
msgstr ""

#: template.py:616
msgid "Anywhere-to-Anywhere Connections"
msgstr "Vilken som helstwhere-to-Vilken som helstwhere Connections"

#: template.py:617
msgid "Connect anything to anything."
msgstr "Connect vilken som helstthing to vilken som helstthing."

#: template.py:619
msgid "Automation Curves"
msgstr ""

#: template.py:620
msgid ""
"Automate parameters with straight lines or curves, choosing from multiple "
"curve algorithms, such as Exponential and Elliptic curves."
msgstr ""

#: template.py:622
msgid "Envelopes"
msgstr ""

#: template.py:623
msgid ""
"Automate parameters with CV signals or envelopes, including macro knobs and "
"LFO plugins such as ZLFO."
msgstr ""

#: template.py:625
msgid "Automate Anything"
msgstr "Automate Vilken som helstthing"

#: template.py:626
msgid ""
"Automate any possible parameter, including the project's BPM and time "
"signature."
msgstr ""
"Automate vilken som helst possible parameter, including the project's BPM "
"and time signature."

#: template.py:629
msgid "Intuitive User Interface"
msgstr ""

#: template.py:632
msgid "Detachable Views"
msgstr "Detachable Visas"

#: template.py:633
msgid ""
"Detach views from any panel and work efficiently with multi-monitor setups."
msgstr ""
"Detach views from vilken som helst panoreringel and work efficiently with "
"multi-monitor setupps."

#: template.py:635
msgid "Searchable Preferences"
msgstr "Sökable Preferences"

#: template.py:636
msgid "Start typing to locate the preference you're looking for."
msgstr "Starta typing to locate the preference you're looking for."

#: template.py:638
msgid "Inspector Pages"
msgstr ""

#: template.py:639
msgid "Edit all track and plugin parameters in the inspector."
msgstr "Redigera alla spår and insticksmodul parameters in the inspector."

#: template.py:642
msgid "Plugin Capabilities"
msgstr "Insticksmodul Capabilities"

#: template.py:645
msgid "Plugin Support"
msgstr "Insticksmodul Suppport"

#: template.py:646
msgid ""
"Thanks to {ref}Carla{endref}, Zrythm supports a variety of plugin formats "
"including LV2, VST2, VST3, AU, CLAP and JSFX."
msgstr ""

#: template.py:648
msgid "SoundFonts as Plugins"
msgstr ""

#: template.py:649
msgid "Use SFZ and SF2 soundfonts as instrument plugins."
msgstr ""

#: template.py:651
msgid "Flexible Plugin Browser"
msgstr "Flexible Insticksmodul Bläddrar"

#: template.py:652
msgid ""
"Easily filter plugins by author, format or category, and organize your "
"favorite plugins with plugin collections."
msgstr ""

#: template.py:654
msgid "Plugin Bridging"
msgstr "Insticksmodul Bridging"

#: template.py:655
msgid "Sandbox plugins by opening them in bridge mode."
msgstr ""

#: template.py:657
msgid "Automatable Bypass Mode"
msgstr "Automatabell Bypass Mode"

#: template.py:658
msgid "Easily bypass plugins in the signal chain with an automatable control."
msgstr ""

#: template.py:661
msgid "Comprehensive Import/Export"
msgstr "Comprehensive Importera/Exportera"

#: template.py:664
msgid "File Browser"
msgstr "Fil Bläddrar"

#: template.py:665
msgid ""
"Browse and audition MIDI and audio files, and organize your favorite paths "
"with favorites."
msgstr ""
"Bläddra and audition MIDI and ljud fils, and organize your favorite sökvägs "
"with favorites."

#: template.py:667
msgid "Audio Files"
msgstr "Ljud Fils"

#: template.py:668
msgid ""
"Import or export any format supported by {ref}libsndfile{endref}, with "
"additional MP3 import support."
msgstr ""

#: template.py:670
msgid "MIDI"
msgstr ""

#: template.py:671
msgid ""
"Import or export any part of the project in MIDI Type 0 or Type 1 formats."
msgstr ""

#: template.py:673
msgid "Stem Export"
msgstr "Stem Exportera"

#: template.py:674
msgid "Export stems for specific tracks and share them with other producers."
msgstr "Exportera stems for specific spårs and share them with annan producers."

#: template.py:677 template.py:778
msgid "Chord Assistance"
msgstr "Ackord Assistance"

#: template.py:680
msgid "Chord Audition"
msgstr "Ackord Audition"

#: template.py:681
msgid ""
"Quickly listen to chords by clicking the pads or pressing notes on your MIDI"
" keyboard, and drag-and-drop chords to the timeline."
msgstr ""

#: template.py:683
msgid "Chord Editing"
msgstr "Ackord Redigeraing"

#: template.py:684
msgid ""
"Invert chords with a single click or use the chord selector to choose any "
"chord, with an option to filter chords in the current scale."
msgstr ""
"Invert ackords with a single klicka or use the ackord väljor to välj vilken "
"som helst ackord, with an alternativ to filtrera ackords in the current "
"skala."

#: template.py:686
msgid "Recordable Chord Track"
msgstr "Spela inable Ackord Spår"

#: template.py:687
msgid ""
"Dictate or record the scale and chord progression of the project, and "
"optionally route the output to an instrument."
msgstr ""
"Dictate or record the skala and ackord progression of the project, and "
"alternativallay route the utmatning to an instrument."

#: template.py:689
msgid "Chord Presets"
msgstr "Ackord Påterställs"

#: template.py:690
msgid ""
"Generate chords from a wide range of scales, load included chord presets for"
" various genres, or save your own."
msgstr ""
"Generate ackords from a wide range of skalas, load included ackord "
"påterställs for various genres, or save your own."

#: template.py:693 template.py:787
msgid "Never Lose Work"
msgstr "Aldrig Lose Work"

#: template.py:696
msgid "Project Backups"
msgstr "Projekt Bakupps"

#: template.py:697
msgid "Backups taken automatically at user-specified intervals."
msgstr "Bakupps taken automatiskallay at user-specified intervals."

#: template.py:699
msgid "Undoable Actions"
msgstr "Ångraable Åtgärds"

#: template.py:700
msgid "Almost every user action is undoable."
msgstr "Almost varje user åtgärd is undoable."

#: template.py:702
msgid "Serializable Undo History"
msgstr "Serializable Ångra History"

#: template.py:703
msgid "Keep your undo history when saving projects."
msgstr ""

#: template.py:706
msgid "Scripting"
msgstr ""

#: template.py:709
msgid "Extend Zrythm"
msgstr "Extslut Zrythm"

#: template.py:710
msgid ""
"Extend the capabilities of Zrythm by editing its state using {ref}GNU Guile "
"scripts{endref}."
msgstr ""
"Extslut the capabilities of Zrythm by editing its state using {ref}GNU Guile "
"scripts{slutref}."

#: template.py:712
msgid "Custom Editor Functions"
msgstr "Anpassad Redigeraor Funktions"

#: template.py:713
msgid "Implement your own MIDI/audio/automation functions (coming soon)."
msgstr "Implement your own MIDI/ljud/automation funktions (coming soon)."

#: template.py:715
msgid "Project Generation"
msgstr "Projekt Generation"

#: template.py:716
msgid "Generate projects with GNU Guile scripts."
msgstr ""

#: template.py:719
msgid "Optimized Performance"
msgstr ""

#: template.py:722
msgid "Hardware accelerated UI"
msgstr ""

#: template.py:723
msgid ""
"Most of the user interface is drawn on the GPU thanks to {ref}GTK4{endref}."
msgstr ""
"Most of the user interface is drawn on the GPU thanks to {ref}GTK4{endref}."

#: template.py:725
msgid "SIMD-optimized DSP"
msgstr ""

#: template.py:726
msgid ""
"Zrythm uses {ref}lsp-dsp-lib{endref} which implements SIMD extensions such "
"as SSE, AVX and FMA when available to speed up audio processing and minimize"
" DSP usage."
msgstr ""
"Zrythm uses {ref}lsp-dsp-lib{slutref} which implements SIMD extensions such "
"as SSE, AVX and FMA when tillgänglig to speed upp ljud bearbetar and "
"minimize DSP usage."

#: template.py:728
msgid "Extensive Caching"
msgstr ""

#: template.py:729
msgid "Expensive computations are pre-calculated to save processing time."
msgstr "Expensive computations are pre-calculated to save bearbetar time."

#: template.py:732
msgid "Cross-Platform Support"
msgstr ""

#: template.py:735
msgid "Multiple Platforms"
msgstr ""

#: template.py:736
msgid ""
"Zrythm is designed to run on a {ref}wide variety of platforms and "
"architectures{endref} including x86 architectures, PowerPC, RISC-V, ARMv7 "
"and ARMv8."
msgstr ""

#: template.py:738
msgid "Multiple Backends"
msgstr "Multiple Baksluts"

#: template.py:739
msgid ""
"Support for almost all major audio and MIDI backends, including "
"JACK/PipeWire, Windows MME, WASAPI and Core Audio/MIDI."
msgstr ""
"Suppport for almost alla major ljud and MIDI baksluts, including JACK/"
"PipeWire, Windows MME, WASAPI and Core Ljud/MIDI."

#: template.py:742
msgid "Localization"
msgstr "Lokalization"

#: template.py:745
msgid "Localized UI"
msgstr "Lokalized UI"

#: template.py:746
msgid "Use Zrythm in your preferred language."
msgstr ""

#: template.py:748
msgid "Easily Add Translations"
msgstr "Easily Lägg till Translations"

#: template.py:749
msgid "Add missing translations and locales on {ref}Weblate{endref}."
msgstr "Lägg till missing translations and lokales on {ref}Weblate{slutref}."

#: template.py:752
msgid "User Freedom"
msgstr ""

#: template.py:755
msgid "Free Software"
msgstr "Free Programvara"

#: template.py:756
msgid "All source code is released as {ref}copyleft free software{endref}."
msgstr ""
"Alla source code is released as {ref}copyvänster free programvara{slutref}."

#: template.py:758
msgid "Open Standards"
msgstr "Öppna Standards"

#: template.py:759
msgid "Zrythm supports open standards such as MIDI, LV2, FLAC and OGG."
msgstr "Zrythm suppports open standards such as MIDI, LV2, FLAC and OGG."

#: template.py:761
msgid "Cooperation"
msgstr ""

#: template.py:762
msgid ""
"We work with the free software community to ensure Zrythm builds and runs "
"without issues on all platforms."
msgstr ""

#: template.py:770
msgid ""
"Easily select, move, resize, clone, link, loop, delete and cut objects with "
"a single tool or extend its functionality with additional specialized tools,"
" and enjoy adaptive snapping in every arranger."
msgstr ""
"Easily välj, move, restorlek, clone, länk, loop, delete and cut objekts with "
"a single verktyg or extslut its funktionality with additional speciellized "
"verktygs, and enjoy adaptiv snapping in varje arranger."

#: template.py:772
msgid "Limitless Automation"
msgstr ""

#: template.py:773
msgid ""
"Automate almost anything with automation events using straight lines, ramps "
"and curves, or with LFOs and envelopes."
msgstr ""
"Automate almost vilken som helstthing with automation events using straight "
"lines, ramps and curves, or with LFOs and envelopes."

#: template.py:776
msgid ""
"In-context listening, signal groups, FX tracks, MIDI effect and insert "
"slots, pre and post-fader aux sends and anywhere-to-anywhere routing."
msgstr ""
"In-context listaening, signal gruppperas, FX spårs, MIDI effect and insert "
"slots, pre and post-fader aux ssluts and vilken som helstwhere-to-vilken som "
"helstwhere routing."

#: template.py:779
msgid ""
"Generate chords from scales in the chord pad, audition and invert chords or "
"save your own chord presets, manage your chord progression in the chord "
"track and enjoy chord highlighting in the piano roll."
msgstr ""
"Generate ackords from skalas in the ackord pad, audition and invert ackords "
"or save your own ackord påterställs, manage your ackord progression in the "
"ackord spår and enjoy ackord highlighting in the pianej roll."

#: template.py:781
msgid "Audio Plugins"
msgstr ""

#: template.py:782
msgid ""
"Support for every major plugin format including {lv2_ref}LV2{endref}, VST2, "
"VST3, AU, CLAP and JSFX, with additional support for SFZ and SF2 soundfonts "
"and sandboxing thanks to {carla_ref}Carla{endref}."
msgstr ""

#: template.py:785
msgid ""
"Organize your work into multiple layers in the same track using track lanes,"
" quickly bounce anything to audio, import/export a wide variety of audio and"
" MIDI formats, stretch or loop any region and select from an array of track "
"types for every purpose."
msgstr ""

#: template.py:788
msgid ""
"Recover your work with automatic project backups, undo almost any user "
"action and even save your undo history with projects."
msgstr ""
"Recover your work with automatisk project bakupps, undo almost vilken som "
"helst user åtgärd and even save your undo history with projects."

#: template.py:790
msgid "Liberating"
msgstr "Befriande"

#: template.py:791
msgid ""
"Zrythm is {copyleft_ref}copyleft{endref} {free_software_ref}free "
"software</a> with fully auditable source code. Use, study, share and improve"
" it freely."
msgstr ""
"Zrythm is {copyvänster_ref}copyvänster{slutref} {free_programvara_ref}free "
"programvara</a> with fully auditabell source code. Use, study, share and "
"improve it freely."

