msgstr "2:a ordningens Butterworth högpassfilter"

#: template.py:471
msgid "2nd-order Butterworth lowpass filter"
msgstr "2:a ordningens Butterworth lågpassfilter"

#: template.py:474
msgid "Parametric equalizer"
msgstr "Parametrisk equalizer"

#: template.py:477
msgid "Dynamic range compressor modelled after the 1176 peak limiter"
msgstr "Kompressor för dynamiskt omfång modellerad efter 1176 peak limitern"

#: template.py:480
msgid "Phasing effect"
msgstr "Phasing-effekt"

#: template.py:483
msgid "Polyphonic synthesizer with 3 detuned oscillator voices"
msgstr ""

